    {
      "label": "apphost:backend",
      "type": "shell",
      "command": "& '${workspaceFolder}/.vscode/scripts/start-apphost-service.ps1' -Target backend",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile", "-Command"
          ]
        }
      },
      "isBackground": true,
      "dependsOn": [
        "apphost:sync-local-dev-config",
        "shared:build"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "apphost",
        "echo": true,
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": [
        {
          "owner": "nest",
          "pattern": {
            "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
            "file": 1,
            "location": 2,
            "severity": 3,
            "code": 4,
            "message": 5
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*(Starting compilation|File change detected).*",
            "endsPattern": ".*Nest application successfully started.*"
          }
        }
      ]
    },
    {
