    {
      "label": "apphost:reload-window",
      "type": "shell",
      "command": "cmd.exe /c start \"\" \"vscode://command/workbench.action.reloadWindow\"",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile", "-Command"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "apphost",
        "echo": true,
        "close": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
