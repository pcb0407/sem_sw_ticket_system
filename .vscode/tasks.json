    {
      "label": "workspace:reset-deps",
      "type": "shell",
      "command": "$paths = @('node_modules','backend/node_modules','frontend/node_modules','shared/node_modules'); foreach ($path in $paths) { if (Test-Path $path) { Remove-Item -LiteralPath $path -Recurse -Force -ErrorAction SilentlyContinue } }; foreach ($path in $paths) { if (Test-Path $path) { cmd /c \"rd /s /q `\"$path`\"\" } }",
