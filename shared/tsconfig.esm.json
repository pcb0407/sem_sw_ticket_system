{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "outDir": "dist/esm",
    "tsBuildInfoFile": "../output/shared/tsconfig.esm.tsbuildinfo",
    "rootDir": "src",
    "incremental": true,
    "declaration": false,
    "sourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}
