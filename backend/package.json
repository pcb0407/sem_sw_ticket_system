{
  "name": "@ticket-system/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "node ../scripts/invoke-workspace-node.cjs ../scripts/ensure-local-build-output.cjs backend",
    "build": "node ../scripts/invoke-workspace-node.cjs ../node_modules/typescript/lib/tsc.js --project tsconfig.json --pretty false",
    "test": "node ../scripts/invoke-workspace-node.cjs ../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "start": "node ../scripts/invoke-workspace-node.cjs dist/main.js",
    "start:dev": "node ../scripts/invoke-workspace-node.cjs --npm run build && node ../scripts/invoke-workspace-node.cjs dist/main.js",
    "start:debug": "node ../scripts/invoke-workspace-node.cjs --npm run build && node ../scripts/invoke-workspace-node.cjs --preserve-symlinks --enable-source-maps --inspect=127.0.0.1:%DEV_BACKEND_DEBUG_PORT% dist/main.js"
  },
  "dependencies": {
    "@ticket-system/shared": "file:../shared",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^11.0.1",
    "@sem/platform-backend": "file:../common-platform/packages/platform-backend",
    "@sem/platform-shared": "file:../common-platform/packages/platform-shared",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.14.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.7.26",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  }
}
