{
  "nodeEnv": "development",
  "apphostRuntime": "local",
  "dockerComposeFile": "docker-compose.yml",
  "dockerProjectName": "sem-sw-ticket-system",
  "dockerApiVersion": "",
  "localNodeModulesRoot": "",
  "syncedStorageRoots": [],
  "syncedStorageSegments": [],
  "browser": {
    "desktopWindowSize": "1440,1024",
    "desktopHighDpiSupport": 1,
    "deviceScaleFactor": 1,
    "mobileWindowSize": "430,932",
    "tabletWindowSize": "1024,1366",
    "arm64DesktopWindowSize": "2160,1536",
    "arm64DeviceScaleFactor": 1.5
  },
  "frontend": {
    "protocol": "http",
    "host": "127.0.0.1",
    "bindHost": "127.0.0.1",
    "port": 5173
  },
  "backend": {
    "protocol": "http",
    "host": "127.0.0.1",
    "bindHost": "127.0.0.1",
    "proxyHost": "127.0.0.1",
    "port": 3001,
    "apiPrefix": "api",
    "swaggerPath": "docs",
    "debugPort": 9231
  },
  "features": {
    "swaggerEnabled": true
  }
}
