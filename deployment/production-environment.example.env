# Copy this file to deployment/production.env or another private path.
# This sample is placeholder-only and must be replaced with real secret manager values.

NODE_ENV=production
CORS_ORIGIN=https://ticket-system.example.internal
API_PREFIX=api

SESSION_SECRET=<32+ character secret>
JWT_SECRET=<32+ character secret>
COOKIE_SECURE=true
DB_SYNCHRONIZE=false
AUDIT_DB_SYNCHRONIZE=false
DB_LOGGING=false
AUDIT_DB_LOGGING=false

# Production standard: use managed server engines for primary and role databases.
DB_TYPE=mssql
AUDIT_DB_TYPE=mssql
USER_DB_TYPE=mssql
TRACE_DB_TYPE=mssql
SYSTEM_DB_TYPE=mssql
SERVICE_DB_TYPE=mssql
SETTING_DB_TYPE=mssql

DB_HOST=<sql-hostname>
DB_NAME=<ticket-system-db-name>
DB_USER=<db-user>
DB_PASSWORD=<db-password>

# MSSQL production deployments must also set:
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
